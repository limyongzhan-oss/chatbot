DATABASE_URL=postgres://dtbm:dtbm@127.0.0.1:5432/dtbm
# 32+ random characters; signs login and check-in cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL used in alert links
APP_URL=http://localhost:3000

# --- Unwell alerts. Any channel left blank runs in demo mode (logged, not sent). ---
# Email via Resend (https://resend.com): API key + a sender on a verified domain
RESEND_API_KEY=
ALERT_EMAIL_FROM=dTBM Alerts <alerts@your-domain.sg>
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# WhatsApp Cloud API (Meta): needs a verified business, phone number ID and an approved template
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=dtbm_unwell
WHATSAPP_TEMPLATE_LANG=en
# Bearer token for POST /api/alerts/dispatch (retries failed alerts; call every few minutes)
CRON_SECRET=

# --- Hosting (Vercel + Supabase) ---
# Hosted Postgres needs TLS. Set to true for Supabase.
DATABASE_SSL=false
# Set to 1 to hide the demo-login box on the login page (do this on any shared link).
HIDE_DEMO_HINT=
# Used only by `npm run db:deploy`, to set the demo accounts' password (default demo1234).
DEMO_PASSWORD=
